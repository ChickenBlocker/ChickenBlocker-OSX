<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.chickenblocker.breaks</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/ChickenBlocker/agent/cb-break-overlay</string>
    </array>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>ThrottleInterval</key>
    <integer>3</integer>
    <key>StandardOutPath</key>
    <string>/tmp/com.chickenblocker.breaks.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/com.chickenblocker.breaks.log</string>
</dict>
</plist>
